# ============================================================
# PANDU — Template Environment Variables
# Salin file ini menjadi '.env' dan isi dengan nilai asli Anda
# !! JANGAN commit file '.env' ke repository/Git !!
# ============================================================
SECRET_KEY=django-insecure-pandu-project-itcc-2026-rahasia
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Konfigurasi MongoDB
# Lokal:  mongodb://localhost:27017/
# Atlas:  mongodb+srv://user:pass@cluster.mongodb.net/
MONGO_URI=mongodb://localhost:27017/
MONGO_DB_NAME=pandu_db

# Konfigurasi Redis (untuk Django Channels Layer)
# Pastikan Redis server sudah berjalan sebelum menjalankan Daphne
REDIS_URL=redis://127.0.0.1:6379

# Konfigurasi MQTT Broker
# Gunakan broker publik untuk dev, broker privat untuk produksi
MQTT_BROKER_HOST=broker.hivemq.com
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=pandu-django-server

# MQTT Topics (HARUS sama persis dengan konfigurasi firmware ESP32)
MQTT_TOPIC_SENSOR=pandu/sensor/data
MQTT_TOPIC_PREDICTION=pandu/ai/prediction
MQTT_TOPIC_ACTUATOR=pandu/actuator/status
